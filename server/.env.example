PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hms_db
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Bootstrapped as the first super_admin account when the User collection is empty at startup.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@hms.test
SUPER_ADMIN_PASSWORD=change_this_password

# Cloudinary (file storage for uploads/documents)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# SMTP Mail Gateway Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
