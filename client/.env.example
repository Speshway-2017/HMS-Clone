
# API URL configuration for LAN access
# Replace "localhost" with your computer's local network IP address (e.g., http://192.168.1.100:5000)
# To find your local IP address, run:
#   Windows: ipconfig (look for "IPv4 Address" under your active network adapter)
#   macOS/Linux: ifconfig or ip addr (look for "inet" address)
VITE_API_URL=http://localhost:5000
